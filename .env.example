# Booking — the "Book a 15 Minute Call" dialog embeds this Calendly event.
# Without it the dialog falls back to the plain contact form below.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/15min

# Fallback contact form. Only used when NEXT_PUBLIC_CALENDLY_URL is unset.
# Any endpoint that accepts a multipart POST works: Formspree, Basin, Getform,
# or an internal handler.
NEXT_PUBLIC_FORM_ENDPOINT=

# Canonical origin, used for metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://example.com
